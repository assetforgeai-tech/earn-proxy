[Unit]
Description=Event-driven Proxy Relay Engine
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/proxy-relay-engine /opt/proxy-relay/relay.json
Restart=always
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGTERM
LimitNOFILE=200000
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
