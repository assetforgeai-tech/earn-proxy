[Unit]
Description=Proxy Relay Manager
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/proxy-relay
EnvironmentFile=/etc/proxy-relay.env
Environment=RELAY_WEB_HOST=127.0.0.1
Environment=RELAY_WEB_PORT=8000
ExecStart=/opt/proxy-relay/.venv/bin/python /opt/proxy-relay/app.py
Restart=always
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
