[Unit]
Description=Earn Proxy earnings and archival maintenance
After=network-online.target earn-proxy-web.service
Wants=network-online.target

[Service]
Type=simple
User=earnproxy
Group=earnproxy
WorkingDirectory=/opt/earn-proxy
EnvironmentFile=/etc/earn-proxy.env
ExecStart=/opt/earn-proxy/.venv/bin/python -m app.maintenance_service
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/earn-proxy

[Install]
WantedBy=multi-user.target
