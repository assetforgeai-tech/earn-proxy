[Unit]
Description=Earn Proxy Proxiware inventory synchronizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=earnproxy
Group=earnproxy
UMask=0007
WorkingDirectory=/opt/earn-proxy
EnvironmentFile=/etc/earn-proxy.env
ExecStart=/opt/earn-proxy/.venv/bin/python -m app.proxiware_sync_service
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/earn-proxy

[Install]
WantedBy=multi-user.target
