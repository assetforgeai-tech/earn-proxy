[Unit]
Description=Earn Proxy web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=earnproxy
Group=earnproxy
WorkingDirectory=/opt/earn-proxy
EnvironmentFile=/etc/earn-proxy.env
ExecStart=/opt/earn-proxy/.venv/bin/python -m gunicorn --bind 127.0.0.1:8100 --workers 2 --threads 4 --timeout 60 "app:create_app()"
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/earn-proxy

[Install]
WantedBy=multi-user.target
