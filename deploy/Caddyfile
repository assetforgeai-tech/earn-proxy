proxy.acacondos.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8100
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

transfer.proxy.acacondos.com {
    encode zstd gzip
    @relay_internal path /internal/feed
    respond @relay_internal 404
    reverse_proxy 127.0.0.1:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

whitelist.proxy.acacondos.com {
    respond "42.96.12.142\n" 200 {
        header Content-Type text/plain
        header Cache-Control "public, max-age=300"
    }
}

earn.proxy.acacondos.com {
    @api path /api/* /internal/api/*
    handle @api {
        reverse_proxy 127.0.0.1:8100
    }
    redir https://proxy.acacondos.com{uri} permanent
}
