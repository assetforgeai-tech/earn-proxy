[Unit]
Description=Earn Proxy Proxiware dashboard observer
Requires=earn-proxy-proxiware-chrome.service
BindsTo=earn-proxy-proxiware-chrome.service
After=network-online.target earn-proxy-proxiware-chrome.service
Wants=network-online.target

[Service]
Type=simple
User=earnproxy-browser
Group=earnproxy
UMask=0007
WorkingDirectory=/opt/earn-proxy
Environment=EARN_PROXY_RUNTIME_PROFILE=proxiware_worker
EnvironmentFile=/etc/earn-proxy-proxiware-worker.env
EnvironmentFile=/etc/earn-proxy-proxiware-worker-key.env
ExecStart=/opt/earn-proxy/.venv/bin/python -m app.proxiware_browser_service
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/earn-proxy

[Install]
WantedBy=multi-user.target
