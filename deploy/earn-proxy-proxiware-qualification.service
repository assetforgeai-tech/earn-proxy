[Unit]
Description=Earn Proxy Proxiware qualification worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=earnproxy
Group=earnproxy
UMask=0007
WorkingDirectory=/opt/earn-proxy
Environment=EARN_PROXY_RUNTIME_PROFILE=proxiware_worker
EnvironmentFile=/etc/earn-proxy-proxiware-worker.env
EnvironmentFile=/etc/earn-proxy-proxiware-worker-key.env
ExecStart=/opt/earn-proxy/.venv/bin/python -m app.services.proxiware_qualification_service
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/earn-proxy

[Install]
WantedBy=multi-user.target
