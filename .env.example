EARN_PROXY_SECRET_KEY=replace-with-a-long-random-session-secret
EARN_PROXY_FERNET_KEY=replace-with-a-valid-fernet-key
EARN_PROXY_INTERNAL_API_KEY=replace-with-a-long-random-api-key
EARN_PROXY_ADMIN_EMAIL=admin@example.com
EARN_PROXY_ADMIN_PASSWORD=replace-with-a-strong-admin-password
EARN_PROXY_DATABASE=/var/lib/earn-proxy/earn-proxy.db
EARN_PROXY_COOKIE_SECURE=1
EARN_PROXY_DOMAIN=earn-proxy.example.com
